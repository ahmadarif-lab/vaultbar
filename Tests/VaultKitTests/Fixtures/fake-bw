#!/usr/bin/env python3
"""Fake `bw` for integration tests: mimics the CLI commands and `bw serve`
REST API VaultBar uses. Never contacts a real server."""
import json, os, sys, http.server, socketserver

DATA = os.environ.get("BITWARDENCLI_APPDATA_DIR", "/tmp/fake-bw")
os.makedirs(DATA, exist_ok=True)
STATE = os.path.join(DATA, "state.json")
ARGV_LOG = os.path.join(DATA, "argv.log")
PASSWORD = "correct-horse"

with open(ARGV_LOG, "a") as f:
    f.write(" ".join(sys.argv[1:]) + "\n")

def load():
    try:
        return json.load(open(STATE))
    except Exception:
        return {"server": "https://bitwarden.com", "email": None}

def save(s):
    json.dump(s, open(STATE, "w"))

def fail(msg, code=1):
    sys.stderr.write(msg + "\n")
    sys.exit(code)

args = sys.argv[1:]
state = load()

if args[:1] == ["--version"]:
    print("2026.1.0")
elif args[:1] == ["status"]:
    print(json.dumps({"serverUrl": state["server"], "userEmail": state["email"],
                      "status": "unauthenticated" if not state["email"] else "locked"}))
elif args[:2] == ["config", "server"]:
    if state["email"]:
        fail("Logout required before server config update.")
    state["server"] = args[2]; save(state); print("Saved setting `serverUrl`.")
elif args[:1] == ["login"]:
    if os.environ.get("VB_PW") != PASSWORD:
        fail("Username or password is incorrect. Try again.")
    if "--code" not in args and os.path.exists(os.path.join(DATA, "needs2fa")):
        fail("Two-step login code is required.")
    state["email"] = args[1]; save(state); print("fake-session-key")
elif args[:1] == ["unlock"]:
    if not state["email"]: fail("You are not logged in.")
    if os.environ.get("VB_PW") != PASSWORD: fail("Invalid master password.")
    print("fake-session-key")
elif args[:1] == ["lock"]:
    print("Your vault is locked.")
elif args[:1] == ["logout"]:
    if not state["email"]: fail("You are not logged in.")
    state["email"] = None; save(state); print("You have logged out.")
elif args[:1] == ["serve"]:
    port = int(args[args.index("--port") + 1])
    session = os.environ.get("BW_SESSION")
    items = [
        {"id": "1", "type": 1, "name": "Alpha", "favorite": True, "folderId": "f1",
         "login": {"username": "a@example.com", "password": "pw", "totp": "GEZDGNBVGY3TQOJQ", "uris": [{"uri": "https://alpha.test"}]}},
        {"id": "2", "type": 1, "name": "Beta", "login": {"username": "b", "password": "pw2"}},
        {"id": "bad", "type": "not-a-number", "name": 5},   # malformed: must be dropped, not fatal
    ]
    synced = {"n": 0}
    class H(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a): pass
        def send(self, obj, code=200):
            body = json.dumps(obj).encode()
            self.send_response(code); self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body))); self.end_headers(); self.wfile.write(body)
        def do_GET(self):
            if self.path == "/status":
                return self.send({"success": True, "data": {"object": "template", "template": {
                    "status": "unlocked" if session else "locked"}}})
            if not session: return self.send({"success": False, "message": "Vault is locked."}, 400)
            if self.path == "/list/object/items":
                return self.send({"success": True, "data": {"object": "list", "data": items}})
            if self.path == "/list/object/folders":
                return self.send({"success": True, "data": {"object": "list", "data": [{"id": "f1", "name": "Work"}]}})
            if self.path == "/list/object/organizations":
                return self.send({"success": True, "data": {"object": "list", "data": []}})
            self.send({"success": False}, 404)
        def do_POST(self):
            if self.path == "/sync":
                synced["n"] += 1
                items.append({"id": "3", "type": 2, "name": "Added by sync"}) if synced["n"] == 1 else None
                return self.send({"success": True, "data": {"object": "message", "title": "Syncing complete."}})
            if self.path == "/lock": return self.send({"success": True, "data": {}})
            self.send({"success": False}, 404)
    socketserver.TCPServer.allow_reuse_address = True
    with socketserver.TCPServer(("127.0.0.1", port), H) as srv:
        srv.serve_forever()
else:
    fail("unknown command")
